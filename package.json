{
  "name": "magpie-extension-contract",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugins": "node scripts/build-plugins.mjs",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run build:plugins && tsc && tsc -p tsconfig.browser.json",
    "test": "npm run build:plugins && vitest run --max-workers=1 --no-isolate",
    "test:browser": "npm run build:plugins && playwright test",
    "dev": "wrangler dev --port 8799"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.3",
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.8",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "esbuild": "0.28.1",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  }
}
